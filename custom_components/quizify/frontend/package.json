{
  "name": "quizify-frontend",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --minify --target=es2020 --jsx=automatic --loader:.css=text --outfile=dist/quizify.js && cp src/styles/quizify.css dist/quizify.css",
    "dev": "esbuild src/index.jsx --bundle --target=es2020 --jsx=automatic --loader:.css=text --watch --outfile=dist/quizify.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
